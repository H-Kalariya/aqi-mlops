# ── AQI Forecaster MLOps — Environment Variables ──
# Copy to .env and fill in real values. NEVER commit .env itself.

# ── API Keys (only needed for live ingestion) ──
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
OPENAQ_API_KEY=your_openaq_api_key_here

# ── MLflow ──
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# ── Docker / Deployment ──
APP_VERSION=1.0.0
COMPOSE_PROJECT_NAME=aqi-mlops

# ── Grafana ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ── Alertmanager (placeholders) ──
ALERTMANAGER_WEBHOOK_URL=http://localhost:9093
ALERTMANAGER_EMAIL_TO=ops@example.com
ALERTMANAGER_EMAIL_FROM=alertmanager@example.com
ALERTMANAGER_SMTP_HOST=smtp.example.com:587
